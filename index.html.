
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZHENYA | Personal Card</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;min-height:100vh;
 background:radial-gradient(ellipse at top,#30343b,#090a0d 65%);
 color:#f5f5f5;font-family:Arial,sans-serif;
 display:flex;align-items:center;justify-content:center;
 padding:25px;
}
.card{
 width:100%;max-width:390px;
 padding:38px 25px;
 border:1px solid #454950;
 border-radius:26px;
 background:linear-gradient(145deg,#191c21,#090a0d);
 box-shadow:0 20px 60px #0009;
 text-align:center;
}
.logo{
 width:75px;height:75px;margin:0 auto 20px;
 border:1px solid #777;border-radius:50%;
 display:flex;align-items:center;justify-content:center;
 font-size:28px;letter-spacing:2px;
 color:#ddd;
}
h1{font-size:27px;letter-spacing:4px;margin:10px 0}
.subtitle{color:#999;letter-spacing:3px;font-size:11px;margin-bottom:35px}
.item{
 display:block;width:100%;padding:19px;
 margin:14px 0;border:1px solid #686d74;
 border-radius:14px;background:#171a1f;
 color:white;text-decoration:none;
 text-align:left;cursor:pointer;
}
.item span{display:block;font-size:11px;color:#999;letter-spacing:2px;margin-bottom:7px}
.item strong{font-size:16px;font-weight:500}
.item:active{background:#30343b}
.payment{
 display:none;margin-top:12px;padding:18px;
 border:1px solid #777;border-radius:14px;
 background:#101216;
}
.number{font-size:19px;letter-spacing:2px;margin:12px 0}
.copy{
 background:#e1e1e1;color:#111;border:0;
 border-radius:9px;padding:12px 20px;
 font-weight:bold;width:100%;
}
.footer{margin-top:30px;color:#666;font-size:10px;letter-spacing:3px}
</style>
</head>
<body>
<div class="card">
 <div class="logo">Z</div>
 <h1>ZHENYA</h1>
 <div class="subtitle">PERSONAL CARD</div>

 <a class="item" href="tel:+380974842902">
  <span>01 / PHONE</span>
  <strong>+380 97 484 29 02 ↗</strong>
 </a>

 <a class="item" href="https://www.instagram.com/__zhenyok___/" target="_blank">
  <span>02 / INSTAGRAM</span>
  <strong>@__zhenyok___ ↗</strong>
 </a>

 <button class="item" onclick="showPayment()">
  <span>03 / PAYMENT</span>
  <strong>Оплатити →</strong>
 </button>

 <div class="payment" id="payment">
  <span>КАРТКА ДЛЯ ОПЛАТИ</span>
  <div class="number" id="cardNumber">4400 0055 4869 8379</div>
  <button class="copy" onclick="copyCard()">КОПІЮВАТИ НОМЕР</button>
 </div>

 <div class="footer">PERSONAL DIGITAL CARD</div>
</div>

<script>
function showPayment(){
 const p=document.getElementById('payment');
 p.style.display=p.style.display==='block'?'none':'block';
}
function copyCard(){
 const number='4400005548698379';
 if(navigator.clipboard){
  navigator.clipboard.writeText(number).then(()=>{
   alert('Номер картки скопійовано!');
  }).catch(()=>alert('Не вдалося скопіювати номер'));
 }else{
  alert('Скопіюй номер: '+number);
 }
}
</script>
</body>
</html>
